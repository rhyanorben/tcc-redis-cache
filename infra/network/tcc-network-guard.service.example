[Unit]
Description=TCC service network restriction
Requires=docker.service
After=docker.service
PartOf=docker.service

[Service]
Type=oneshot
# Use postgres na tcc-postgres; redis na tcc-redis.
ExecStart=/usr/local/sbin/tcc-restrict-service postgres
RemainAfterExit=yes

[Install]
WantedBy=docker.service
